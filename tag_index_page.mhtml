ubmit"] { cursor: pointer; appearance: button; }

label, select, button, input[type=3D"button"], input[type=3D"reset"], input=
[type=3D"submit"], input[type=3D"radio"], input[type=3D"checkbox"] { cursor=
: pointer; }

